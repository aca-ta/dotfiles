{
  "env": {
    "DATABRICKS_WORKSPACE_PROFILE": "DEFAULT"
  },
  "permissions": {
    "allow": [
      "List(*)",
      "Fetch(https://*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(npm run lint)",
      "Bash(uv run ruff)",
      "Bash(gh pr list)",
      "Bash(gh pr view)",
      "Bash(gh pr diff)",
      "Read(./**/*.py)",
      "Read(./**/*.ts)",
      "Read(./**/*.sh)",
      "Bash(aws s3 ls *)",
      "Bash(aws --profile prd s3 ls *)",
      "Bash(aws s3api get-bucket-policy *)",
      "Bash(aws s3api head-object *)",
      "Bash(aws sts get-caller-identity)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(aws iam get-role *)",
      "Bash(aws configure list-profiles *)",
      "Bash(terraform validate)",
      "Bash(terraform validate *)",
      "Bash(terraform init)",
      "Bash(terraform init *)",
      "Bash(terraform providers *)",
      "Bash(databricks api get *)",
      "Bash(databricks account groups get *)",
      "Bash(databricks account groups list *)",
      "Bash(databricks account workspaces list *)",
      "Bash(databricks account users get *)",
      "Bash(databricks account workspace-assignment list *)",
      "Bash(databricks account service-principal-federation-policy list *)",
      "Bash(databricks catalogs get *)",
      "Bash(databricks external-locations list *)",
      "Bash(databricks jobs list *)",
      "Bash(databricks jobs list-runs *)",
      "Bash(databricks jobs get-run *)",
      "Bash(databricks pipelines get *)",
      "Bash(databricks pipelines list-pipelines *)",
      "Bash(databricks warehouses list *)",
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npx tsc)",
      "Bash(npx tsc *)",
      "Bash(npx eslint)",
      "Bash(npx eslint *)",
      "Bash(uv run ruff *)",
      "mcp__databricks_sql__execute_sql_read_only",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude_ai_Slack__slack_search_public",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Notion__fetch",
      "mcp__claude_ai_Notion__search"
    ],
    "deny": [
      "Bash(databricks api post *)",
      "Bash(databricks api patch *)",
      "Bash(databricks api put *)",
      "Bash(databricks api delete *)",
      "Bash(databricks jobs reset *)",
      "Bash(databricks jobs update *)",
      "Bash(databricks jobs create *)",
      "Bash(databricks jobs delete *)",
      "Bash(databricks bundle deploy *)",
      "Bash(databricks pipelines delete *)"
    ]
  },
  "model": "opus[1m]",
  "enabledMcpjsonServers": [
    "databricks_sql"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__databricks_sql__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\", \"permissionDecisionReason\": \"execute_sql is NOT allowed. Use execute_sql_read_only instead.\"}}'"
          }
        ]
      },
      {
        "matcher": "mcp__databricks_sql__execute_sql_read_only",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"allow\"}}'"
          }
        ]
      },
      {
        "matcher": "mcp__databricks_sql__poll_sql_result",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"allow\"}}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title \"Claude Code\" -message \"Waiting for your response...\" -sound default"
          },
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && { tmux set-window-option -t \"$TMUX_PANE\" window-status-style 'bg=green,fg=black'; tmux set-window-option -t \"$TMUX_PANE\" window-status-current-style 'bg=green,fg=black'; } 2>/dev/null; true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && { tmux set-window-option -t \"$TMUX_PANE\" window-status-style 'bg=yellow,fg=black'; tmux set-window-option -t \"$TMUX_PANE\" window-status-current-style 'bg=yellow,fg=black'; } 2>/dev/null; true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && { tmux set-window-option -t \"$TMUX_PANE\" -u window-status-style; tmux set-window-option -t \"$TMUX_PANE\" -u window-status-current-style; } 2>/dev/null; true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "normal"
}
